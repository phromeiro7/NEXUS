{
  "name": "@nexus/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build-vercel.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "reminders:tick": "tsx --env-file-if-exists=.env scripts/reminders-tick.ts",
    "reminders:loop": "tsx --env-file-if-exists=.env scripts/reminders-loop.ts",
    "telegram:poll": "tsx --env-file-if-exists=.env scripts/telegram-poll.ts",
    "smoke:assistant": "tsx scripts/assistant-smoke.ts",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nexus/shared": "workspace:*",
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15"
  }
}
